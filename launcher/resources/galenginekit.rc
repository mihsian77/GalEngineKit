// GalEngineKit 资源文件
// 图标、版本信息等

// 主图标
1 ICON "icon.ico"

// 版本信息
1 VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GalEngineKit Contributors"
            VALUE "FileDescription",  "GalEngineKit Launcher - galgame engine toolkit"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "GalEngineKitLauncher"
            VALUE "LegalCopyright",   "Copyright (C) 2026 GalEngineKit Contributors"
            VALUE "OriginalFilename", "GalEngineKitLauncher.exe"
            VALUE "ProductName",      "GalEngineKit"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
